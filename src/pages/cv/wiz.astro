---
import Base from '../../layouts/Base.astro';
import '../../styles/project.css';

const tags = ['pm', 'iot', 'matter_protocol', '3p_integration', 'ux', 'business_development'];
const glance = [
  ['Role', 'Product Manager'],
  ['Scale', '1M+ devices'],
  ['Timeline', 'One year, aligned with the Matter launch'],
  ['Team', '~10 engineers, 2 architects, 1 designer'],
];
const team = [
  ['Product Manager (me)', 'Defined product strategy, led cross-functional execution'],
  ['System Architects (2)', 'Designed scalable architecture and protocol adaptation'],
  ['Engineers (~10)', 'Firmware, app, cloud, and hardware validation'],
  ['UI/UX Designer (1)', 'Supported user flow alignment and interface design'],
  ['Cross-functional partners', 'GPM, QA, Legal, and external partners (Google, Amazon, Apple, SmartThings, Home Assistant)'],
];
const challenges = [
  ['Nascent protocol mastery', 'Reviewed thousands of pages of Matter specifications and initiated internal knowledge sharing.'],
  ['End-to-end OTA integration', 'Coordinated production-to-field rollout for millions of devices, ensuring seamless OTA updates.'],
  ['System & UX alignment', 'Integrated Matter and WiZ ecosystems on a single chip while preserving intuitive user flows.'],
  ['Aggressive timeline', 'Delivered full protocol support within one year, aligned with Matter’s global launch.'],
];
const contributions = [
  ['Protocol strategy & execution', 'Defined end-to-end integration flows from manufacturing to certification.'],
  ['Cross-team coordination', 'Led SAFe Scrum-based sprints across firmware, app, and cloud teams.'],
  ['Interoperability testing', 'Ensured compatibility with major controllers (Google Nest Hub, Apple HomePod mini, etc.).'],
  ['Certification management', 'Handled the CSA certification process and coordinated with external partners.'],
  ['Rollout & enablement', 'Designed a phased OTA rollout strategy and ran Matter workshops for internal and external teams.'],
  ['Post-launch optimization', 'Monitored KPIs and established feedback loops for continuous improvement.'],
];
const phases = [
  ['Initiation', ['Reviewed Matter specifications', 'Formed cross-functional working groups']],
  ['Planning', ['Defined end-to-end flows from factory to certification', 'Adjusted security and NPI hardware flows', 'Built roadmap and allocated resources']],
  ['Development & Testing', ['Fostered continuous feedback across teams', 'Tested interoperability with major controllers', 'Coordinated SAFe Scrum sprints']],
  ['Release & Deployment', ['Managed CSA certification', 'Designed phased OTA rollout', 'Delivered Matter workshops']],
  ['Iteration & Impact', ['Monitored device performance and adoption', 'Established feedback channels for future improvements']],
];
const achievements = [
  ['Global Matter Certification Leader (2024)', 'Achieved the highest number of CSA Matter certifications worldwide.'],
  ['Amazon partnership pioneer', 'Initiated WiZ’s first FFS/Matter-based strategic collaboration with Amazon.'],
  ['Protocol integration success', 'Led adoption of a complex, evolving protocol across a diverse product portfolio.'],
  ['Enhanced ecosystem interoperability', 'Improved user experience and expanded market reach through seamless smart home integration.'],
];
const gallery = [
  ['wiz_matter_app.png', 'Matter flow in app', '#app #Matter #OTA'],
  ['wiz_smartthings.png', 'Demo with partners', '#partnerships'],
  ['3rdparties_share_diagram.png', 'Diagram for mechanism discussion', '#spec'],
  ['WiZ_testing_flow.png', 'Test flow discussion', '#validation'],
];
---
<Base title="WiZ Matter Integration · Maude Shen">
  <main class="proj">
    <a class="back" href="/cv">← Back to CV</a>

    <header class="proj-head">
      <p class="eyebrow">Platform &amp; Ecosystem</p>
      <h1>WiZ Matter Integration</h1>
      <p class="sub">Led the adoption of Matter across WiZ&rsquo;s ecosystem of over one million devices, shipping within one year of the protocol release.</p>
      <div class="tags">{tags.map((t) => <span>#{t}</span>)}</div>
    </header>

    <img class="hero-img" src="/cv/wiz_smart_lighting.png" alt="WiZ smart lighting" />

    <dl class="glance">
      {glance.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
    </dl>

    <section class="block">
      <h2>Overview</h2>
      <p class="lead">With no prior team experience in Matter, I developed a comprehensive strategy leveraging internal and external resources to ensure successful integration and certification.</p>
    </section>

    <section class="block two">
      <h2>Why Matter?</h2>
      <div>
        <p>WiZ has long invested in direct API integrations with Google, Alexa, SmartThings and other major platforms. But with roughly half of our users on iPhone, the market, customers, and our own sales teams consistently told us Apple Home support was a critical gap. Matter was our opportunity to close it, and to go further.</p>
        <p>By adopting Matter, WiZ gains a single path to interoperability across all major smart home ecosystems, today&rsquo;s and tomorrow&rsquo;s. It also positions us to support FFS (Frustration-Free Setup) and unlocks new business with partners who require open-standard compatibility.</p>
      </div>
      <aside class="callout">
        <h3>The trade-off</h3>
        <p>Shipping on time required focused prioritization. I deliberately concentrated on WiZ-centric behavior design and deferred certain improvements, such as the indirect factory reset flow via the app. It cost us some complaints from partners and users, but it was the right call to protect the delivery timeline and momentum at the time.</p>
      </aside>
    </section>

    <section class="block">
      <h2>Team &amp; my role</h2>
      <table class="tbl">
        <tbody>{team.map(([a, b], i) => <tr class={i === 0 ? 'me' : ''}><th>{a}</th><td>{b}</td></tr>)}</tbody>
      </table>
    </section>

    <section class="block">
      <h2>Key challenges</h2>
      <div class="cards2">{challenges.map(([t, d], i) => <div class="tile"><span class="num">0{i + 1}</span><h3>{t}</h3><p>{d}</p></div>)}</div>
    </section>

    <section class="block">
      <h2>Key contributions</h2>
      <div class="cards3">{contributions.map(([t, d]) => <div class="tile"><h3>{t}</h3><p>{d}</p></div>)}</div>
    </section>

    <section class="block">
      <h2>Development lifecycle</h2>
      <ol class="steps">
        {phases.map(([t, items], i) => (
          <li><span class="dot">{i + 1}</span><div><h3>{t}</h3><ul>{items.map((x) => <li>{x}</li>)}</ul></div></li>
        ))}
      </ol>
    </section>

    <section class="block">
      <h2>Achievements</h2>
      <div class="cards2">{achievements.map(([t, d]) => <div class="tile win"><h3>★ {t}</h3><p>{d}</p></div>)}</div>
    </section>

    <section class="block">
      <h2>Gallery</h2>
      <div class="gal">
        {gallery.map(([f, c, t]) => (
          <figure><img src={`/cv/${f}`} alt={c} loading="lazy" /><figcaption><b>{c}</b><span>{t}</span></figcaption></figure>
        ))}
      </div>
    </section>

    <nav class="next">
      <a href="/cv">← All projects</a>
      <a href="/cv/igaming/">Next: iGaming Platform →</a>
    </nav>
  </main>
</Base>

